# ---------------------------------------------------------------------------
# Fiches & Cloud — Git ignore rules
# ---------------------------------------------------------------------------

# Local environment / Firebase credentials (never commit real keys)
src/env-config.js
.env
.env.*

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (not required for this zero-build project, kept for safety)
node_modules/
